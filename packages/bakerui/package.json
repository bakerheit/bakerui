{
  "name": "bakerui",
  "version": "0.2.0",
  "description": "A small, longevity-focused React component library themed with CSS variables.",
  "license": "MIT",
  "author": "bakerheit",
  "keywords": [
    "react",
    "components",
    "ui",
    "ui-kit",
    "design-system",
    "css-variables",
    "themeable"
  ],
  "type": "module",
  "main": "./dist/bakerui.cjs",
  "module": "./dist/bakerui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bakerui.js",
      "require": "./dist/bakerui.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
