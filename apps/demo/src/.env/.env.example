# Example env file for the demo. Copy to `.env.production` (or `.env`)
# and flip values as needed. All env files are gitignored except this
# one — see the root `.gitignore`.
#
# Defaults if a flag is missing:
#   - In dev (`vite dev`)       → all packs visible.
#   - In production build       → all packs hidden.
#
# `VITE_SHOW_ADDONS` is the master switch. Both layers must be `true`
# for an individual pack to render.

VITE_SHOW_ADDONS=false

VITE_SHOW_PACK_AUDIO=false
VITE_SHOW_PACK_VIDEO=false
VITE_SHOW_PACK_CALENDAR=false
VITE_SHOW_PACK_COMMERCE=false
VITE_SHOW_PACK_POS=false
VITE_SHOW_PACK_CHAT=false
